# Allowlist, not a blocklist. This repo carries ~37GB the server image must
# never see (comfyui/ 12G, thirdparty/ 25G, release/ 1.2G), and — critically —
# data/app.db holds live third-party API keys and access tokens in its Settings
# row. A forgotten blocklist entry would bake those into a shared image, so the
# default here is "exclude everything" and each addition is deliberate.
*

# --- needed to build the frontend bundle in the builder stage ---
!package.json
!package-lock.json
!vite.config.js
!index.html
!src/
!public/

# --- the server itself ---
!server.js
!storage.js
!wikiStorage.js
!auth.js
!serverMode.js
!gateway.js
!dataStore.js
!uploadQueue.js
!logs.js
!meshPivot.js
!meshRigTransfer.js
!skinTransfer.js
!pgEmbedded.js
!db/
!version.json
!meshNormals.js

# mcp/ is imported statically by server.js, so it must resolve even though the
# /mcp route is not mounted in server mode.
!mcp/

# The VFX contract (schema, catalog, compiler, IR). Needed TWICE OVER: the
# runtime stage imports it from server.js, and the builder stage's `COPY . .`
# is filtered by this same allowlist - so without it the FRONTEND build fails
# to resolve ../../vfx/*.js and the image build dies at vite.
!vfx/

# The building generator contract. Needed TWICE OVER for the same reason as
# vfx/: the runtime stage imports it from server.js, and the builder stage's
# `COPY . .` is filtered by this allowlist - so without it the FRONTEND build
# fails to resolve ../../building/*.js and the image build dies at vite.
!building/

# The Batch document model. Needed twice over, exactly like vfx/ and building/:
# the runtime stage reaches it from server.js through the MCP batch tools, and
# the builder stage's `COPY . .` is filtered by this allowlist - so without it
# the FRONTEND build fails to resolve ../../batch/document.js and the image
# build dies at vite.
!batch/
!animation/
!vfxPreview.js

# File-based wiki (resolved against the module dir, not cwd).
!wiki/

# The Unity importer, which the server copies into every exported VFX bundle
# (copyUnityImporterInto). BOTH ENTRIES ARE LOAD-BEARING, and they fail in two
# different ways:
#
#   - the .unitypackage is named as a FILE by the Dockerfile, so leaving it out
#     of this allowlist stops the build dead with "not found";
#   - the package FOLDER is named as a directory, and Docker copies a directory
#     whose every member is ignored as an EMPTY one without complaining. That
#     builds a perfectly good image whose VFX export throws "the Unity importer
#     is not present in this installation" the first time anyone uses it.
#
# Listed precisely rather than as !plugins/: that directory also holds the
# Phase 0 spikes, the packaging tool and the whole Unreal plugin, none of which
# a server image has any use for.
!plugins/unity/com.3dgenstudio.vfx-import/
!plugins/unity/3dgenstudio-vfx-import.unitypackage

# Re-exclude junk that the directory allowances above would otherwise pull back in.
**/node_modules
**/__pycache__
**/*.log

# Belt and braces. .dockerignore takes the LAST matching rule, so these sit
# after every negation and cannot be re-included by accident.
data/
comfyui/
thirdparty/
python-server/
electron/
release/
build/
resources/
# ...except the VFX preset library, which the server reads and serves. The rest
# of resources/ is animation GLBs, preview videos and Python wheels that only a
# desktop install uses.
!resources/vfx/
# ...and the building style packs, read by /api/buildings/styles.
!resources/buildings/
tools/
setup/
dist/
.git/
.env
.env.*
.wiki-author

# After the tools/ exclusion above, deliberately: the last matching rule wins,
# so this negation has to come later than the directory it re-opens. Only the
# one migration script, not the rest of tools/.
!tools/migrate-sqlite-to-postgres.mjs

